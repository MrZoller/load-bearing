{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // The purity gate scans .js/.jsx/.mjs/.cjs under engine/, so the type
    // programs have to cover them too. Without this a JavaScript engine source
    // is checked by a text grep alone — and a grep cannot know that
    // `location.origin` is a browser ambient.
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "engine",
    "runtime",
    "content",
    "pipeline",
    "vitest.config.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "e2e",
    // Every TypeScript script, not a named list. `scripts/update-schema.ts`
    // generates the published cartridge contract and was typechecked by
    // nothing at all, so a broken import in it would merge green and fail only
    // when someone next needed to regenerate the schema. The glob is `*.ts`
    // rather than the directory: `allowJs`/`checkJs` would otherwise pull in
    // the `.mjs` gate scripts, which are deliberately plain Node.
    "scripts/*.ts"
  ]
}
