{
  "name": "load-bearing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A daily interactive comedy wearing the costume of a serious developer tool.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:browser": "npm run build && playwright test",
    "test": "vitest run",
    "test:coverage": "TZ=UTC vitest run --coverage",
    "test:watch": "vitest",
    "test:timezones": "TZ=UTC npm test && TZ=Asia/Tokyo npm test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.engine.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate:purity": "node scripts/gate-purity.mjs",
    "fixtures:update": "vite-node scripts/update-fixtures.ts",
    "schema:update": "vite-node scripts/update-schema.ts",
    "verify": "npm run typecheck && npm run format:check && npm run gate:purity && npm run test:coverage && npm run test:timezones && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^3.2.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "8.2.2",
    "vite-node": "^3.0.5",
    "vitest": "^3.0.5"
  }
}
