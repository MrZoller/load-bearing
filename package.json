{
  "name": "load-bearing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A daily interactive comedy wearing the costume of a serious developer tool.",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate:purity": "node scripts/gate-purity.mjs",
    "fixtures:update": "vite-node scripts/update-fixtures.ts",
    "verify": "npm run typecheck && npm run format:check && npm run gate:purity && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite-node": "^3.0.5",
    "vitest": "^3.0.5"
  }
}
